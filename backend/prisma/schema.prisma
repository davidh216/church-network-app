generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  bio       String?
  isActive  Boolean  @default(true)
  
  // Enhanced member information
  firstName        String?
  lastName         String?
  dateOfBirth      DateTime?
  gender           String?    // "male", "female", "other", "prefer_not_to_say"
  maritalStatus    String?    // "single", "married", "divorced", "widowed", "separated"
  occupation       String?
  emergencyContact String?
  emergencyPhone   String?
  
  // Church-specific information
  membershipDate   DateTime?
  baptismDate      DateTime?
  confirmationDate DateTime?
  membershipType   String?    // "member", "visitor", "regular_attendee", "inactive"
  previousChurch   String?
  howHeardAboutUs  String?
  
  // Address information
  address          String?
  city             String?
  state            String?
  zipCode          String?
  country          String?
  
  // Communication preferences
  emailOptIn       Boolean  @default(true)
  smsOptIn         Boolean  @default(false)
  mailOptIn        Boolean  @default(true)
  
  // Family information
  familyId         String?
  isHeadOfFamily   Boolean  @default(false)
  
  // Notes and tracking
  notes            String?
  lastAttended     DateTime?
  lastLoginAt      DateTime?   // Track when user last logged in
  volunteerSkills  String?    // JSON array as string
  interests        String?    // JSON array as string
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  roles        UserRole[]
  mediaUploads Media[]
  family       Family?        @relation(fields: [familyId], references: [id])
  groupMembers GroupMember[]
  attendances  Attendance[]
  
  // CRM Relations
  engagement     MemberEngagement?
  activities     MemberActivity[]
  interactions   MemberInteraction[]
  milestones     MemberMilestone[]
  memberNotes    MemberNote[]
  memberTags     UserTag[]
  
  // Phase 3: Family Relationships
  familyRelationships     FamilyRelationship[] @relation("UserAsPrimary")
  relatedFamilyMembers    FamilyRelationship[] @relation("UserAsRelated")
  
  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique // "admin", "leader", "member"
  description String?
  permissions String // JSON string for now
  
  // Relations
  users UserRole[]
  
  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@map("user_roles")
}

model Media {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    // IMAGE, VIDEO, AUDIO, DOCUMENT, YOUTUBE_VIDEO
  url         String
  thumbnailUrl String?
  fileSize    Int?
  mimeType    String?
  
  // Content organization
  tags        String    // JSON array as string
  isApproved  Boolean   @default(false)
  isPublic    Boolean   @default(true)
  
  // Upload info
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("media")
}

model Family {
  id          String @id @default(cuid())
  familyName  String
  headOfFamily String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     User[]
  relationships FamilyRelationship[]
  
  @@map("families")
}

// Phase 3: New model for family relationships
model FamilyRelationship {
  id              String @id @default(cuid())
  primaryUserId   String
  relatedUserId   String
  relationshipType String // "spouse", "parent", "child", "sibling", "grandparent", "grandchild", "other"
  isActive        Boolean @default(true)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  primaryUser     User   @relation("UserAsPrimary", fields: [primaryUserId], references: [id], onDelete: Cascade)
  relatedUser     User   @relation("UserAsRelated", fields: [relatedUserId], references: [id], onDelete: Cascade)
  family          Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId        String
  
  @@unique([primaryUserId, relatedUserId, relationshipType])
  @@map("family_relationships")
}

model Group {
  id          String @id @default(cuid())
  name        String
  description String?
  type        String  // "ministry", "small_group", "committee", "service_team"
  isActive    Boolean @default(true)
  meetingDay  String? // "monday", "tuesday", etc.
  meetingTime String?
  location    String?
  
  // Leadership
  leaderId    String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     GroupMember[]
  
  @@map("groups")
}

model GroupMember {
  id       String @id @default(cuid())
  userId   String
  groupId  String
  role     String @default("member") // "leader", "co-leader", "member"
  joinDate DateTime @default(now())
  isActive Boolean @default(true)
  
  // Relations
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@unique([userId, groupId])
  @@map("group_members")
}

model Attendance {
  id           String   @id @default(cuid())
  userId       String
  serviceDate  DateTime
  serviceType  String   @default("sunday_service") // "sunday_service", "bible_study", "prayer_meeting", etc.
  present      Boolean  @default(true)
  notes        String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  
  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, serviceDate, serviceType])
  @@map("attendance")
}

model MemberEngagement {
  id                 String   @id @default(cuid())
  userId             String
  engagementScore    Float    @default(0)    // 0-100 engagement score
  lastCalculated     DateTime @default(now())
  
  // Engagement metrics
  attendanceScore    Float    @default(0)    // Based on service attendance
  givingScore        Float    @default(0)    // Based on giving consistency
  volunteerScore     Float    @default(0)    // Based on volunteer participation
  communityScore     Float    @default(0)    // Based on group participation
  communicationScore Float    @default(0)    // Based on email/sms engagement
  
  // Activity counters (rolling 12 months)
  servicesAttended   Int      @default(0)
  eventsAttended     Int      @default(0)
  volunteerHours     Float    @default(0)
  donationCount      Int      @default(0)
  groupMeetings      Int      @default(0)
  
  // Lifecycle indicators
  membershipStage    String   @default("visitor") // "visitor", "new_member", "active_member", "core_member", "leader", "at_risk", "inactive"
  riskLevel          String   @default("low")     // "low", "medium", "high"
  lastActivity       DateTime?
  
  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@map("member_engagement")
}

model MemberActivity {
  id          String   @id @default(cuid())
  userId      String
  activityType String  // "service_attendance", "event_attendance", "donation", "volunteer", "communication_open", "profile_update", etc.
  description String?
  metadata    String?  // JSON string for additional data
  points      Int      @default(0) // Points awarded for this activity
  
  // Timestamps
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("member_activities")
}

model MemberInteraction {
  id             String   @id @default(cuid())
  userId         String
  interactionType String  // "email_sent", "email_opened", "sms_sent", "sms_replied", "call_made", "visit_logged", "note_added"
  subject        String?
  content        String?
  staffMemberId  String?  // Who initiated the interaction
  channel        String   // "email", "sms", "phone", "in_person", "social_media"
  status         String   @default("completed") // "scheduled", "completed", "failed"
  
  // Phase 3: Enhanced interaction tracking
  category       String?  // "welcome", "follow_up", "pastoral_care", "event_invitation", "giving_reminder", "volunteer_request"
  priority       String   @default("normal") // "low", "normal", "high", "urgent"
  responseRequired Boolean @default(false)
  responseReceived Boolean @default(false)
  
  // Metadata
  metadata       String?  // JSON for additional data
  responseTime   Int?     // Minutes to respond (for two-way communications)
  
  // Timestamps
  scheduledFor   DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  
  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("member_interactions")
}

model MemberMilestone {
  id            String   @id @default(cuid())
  userId        String
  milestoneType String   // "first_visit", "baptism", "confirmation", "wedding", "first_volunteer", "leadership_role", "anniversary"
  title         String
  description   String?
  achievedDate  DateTime
  isPublic      Boolean  @default(true)
  celebrated    Boolean  @default(false)
  
  // Phase 3: Enhanced milestone categorization
  category      String   @default("general") // "spiritual", "service", "family", "personal", "ministry"
  impact        String   @default("medium")  // "low", "medium", "high"
  autoGenerated Boolean  @default(false)     // Whether milestone was auto-detected
  
  // Timestamps
  createdAt     DateTime @default(now())
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("member_milestones")
}

model MemberNote {
  id           String   @id @default(cuid())
  userId       String
  authorId     String   // Staff member who wrote the note
  title        String?
  content      String
  noteType     String   @default("general") // "general", "pastoral_care", "follow_up", "prayer_request", "concern"
  isPrivate    Boolean  @default(false)
  isFollowUp   Boolean  @default(false)
  followUpDate DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("member_notes")
}

model MemberTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3B82F6") // Hex color for UI display
  category  String   @default("general") // "ministry", "demographic", "interest", "status", "general"
  isActive  Boolean  @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  
  // Relations
  memberTags UserTag[]
  
  @@map("member_tags")
}

model UserTag {
  id       String @id @default(cuid())
  userId   String
  tagId    String
  addedBy  String? // Staff member who added the tag
  addedAt  DateTime @default(now())
  
  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag      MemberTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([userId, tagId])
  @@map("user_tags")
}

model SavedSearch {
  id          String   @id @default(cuid())
  name        String
  description String?
  query       String   // JSON string containing the search query
  isPublic    Boolean  @default(false)
  createdBy   String   // User who created the search
  usageCount  Int      @default(0)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsed    DateTime?
  
  @@map("saved_searches")
}