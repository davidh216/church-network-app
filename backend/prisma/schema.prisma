generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  bio       String?
  isActive  Boolean  @default(true)
  
  // Enhanced member information
  firstName        String?
  lastName         String?
  dateOfBirth      DateTime?
  gender           Gender?
  maritalStatus    MaritalStatus?
  occupation       String?
  emergencyContact String?
  emergencyPhone   String?
  
  // Church-specific information
  membershipDate   DateTime?
  baptismDate      DateTime?
  confirmationDate DateTime?
  membershipType   MembershipType?
  previousChurch   String?
  howHeardAboutUs  String?
  
  // Address information
  address          String?
  city             String?
  state            String?
  zipCode          String?
  country          String?
  
  // Communication preferences
  emailOptIn       Boolean  @default(true)
  smsOptIn         Boolean  @default(false)
  mailOptIn        Boolean  @default(true)
  
  // Family information
  familyId         String?
  
  // Notes and tracking
  notes            String?
  lastAttended     DateTime?
  lastLoginAt      DateTime?   // Track when user last logged in
  volunteerSkills  String[]   @default([])
  interests        String[]   @default([])
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  roles        UserRole[]
  mediaUploads Media[]
  family       Family?        @relation(fields: [familyId], references: [id])
  groupMembers GroupMember[]
  attendances  Attendance[]
  
  // CRM Relations
  engagement     MemberEngagement?
  engagementSnapshots EngagementSnapshot[]
  activities     MemberActivity[]
  interactions   MemberInteraction[]
  milestones     MemberMilestone[]
  memberNotes    MemberNote[]
  memberTags     UserTag[]
  
  // Phase 3: Family Relationships
  familyRelationships     FamilyRelationship[] @relation("UserAsPrimary")
  relatedFamilyMembers    FamilyRelationship[] @relation("UserAsRelated")

  // Rows this user authored, owns or leads (PHASE3_SPECS.md 1.2)
  authoredNotes     MemberNote[]        @relation("NoteAuthor")
  staffInteractions MemberInteraction[] @relation("InteractionStaff")
  savedSearches     SavedSearch[]
  tagsAdded         UserTag[]           @relation("TagAddedBy")
  ledGroups         Group[]
  headedFamilies    Family[]            @relation("FamilyHead")
  servicesCreated   Service[]           @relation("ServiceCreatedBy")
  attendanceRecorded Attendance[]       @relation("AttendanceRecordedBy")
  
  @@index([familyId])
  @@index([isActive])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([membershipDate])
  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String @unique // "admin", "leader", "member"
  description String?
  permissions String[] @default([])
  
  // Relations
  users UserRole[]
  
  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Media {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        MediaType
  url         String
  thumbnailUrl String?
  fileSize    Int?
  mimeType    String?
  
  // Content organization
  tags        String[]  @default([])
  isApproved  Boolean   @default(false)
  isPublic    Boolean   @default(true)
  
  // Upload info
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([uploadedById])
  @@index([createdAt])
  @@map("media")
}

model Family {
  id          String @id @default(cuid())
  familyName  String
  headOfFamilyId String?
  headOfFamily   User?   @relation("FamilyHead", fields: [headOfFamilyId], references: [id], onDelete: SetNull)
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     User[]
  relationships FamilyRelationship[]
  
  @@index([headOfFamilyId])
  @@map("families")
}

// Phase 3: New model for family relationships
model FamilyRelationship {
  id              String @id @default(cuid())
  primaryUserId   String
  relatedUserId   String
  relationshipType RelationshipType
  isActive        Boolean @default(true)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  primaryUser     User   @relation("UserAsPrimary", fields: [primaryUserId], references: [id], onDelete: Cascade)
  relatedUser     User   @relation("UserAsRelated", fields: [relatedUserId], references: [id], onDelete: Cascade)
  family          Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId        String
  
  // One row per pair, stored with primaryUserId < relatedUserId; relationshipType is the
  // primary's relation to the related user (PHASE3_SPECS.md 1.2).
  @@unique([primaryUserId, relatedUserId])
  @@index([relatedUserId])
  @@index([familyId])
  @@map("family_relationships")
}

model Group {
  id          String @id @default(cuid())
  name        String
  description String?
  type        GroupType
  isActive    Boolean @default(true)
  meetingDay  String? // "monday", "tuesday", etc.
  meetingTime String?
  location    String?
  
  // Leadership
  leaderId    String?
  leader      User?   @relation(fields: [leaderId], references: [id], onDelete: SetNull)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     GroupMember[]
  
  @@index([leaderId])
  @@map("groups")
}

model GroupMember {
  id       String @id @default(cuid())
  userId   String
  groupId  String
  role     GroupMemberRole @default(member)
  joinDate DateTime @default(now())
  isActive Boolean @default(true)
  
  // Relations
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_members")
}

// A held service (PHASE3_SPECS.md 1.4): one per date and type. Attendance rows point at it, and
// attendance scores count services in a window by `date`.
model Service {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  type        ServiceType @default(sunday_service)
  title       String?
  notes       String?
  createdById String?
  createdBy   User?       @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  // Relations
  attendance  Attendance[]

  @@unique([date, type])
  @@index([date])
  @@index([createdById])
  @@map("services")
}

model Attendance {
  id           String   @id @default(cuid())
  userId       String
  serviceId    String
  present      Boolean  @default(true)
  notes        String?
  recordedById String?  // Staff member who last recorded this row
  
  // Timestamps
  createdAt    DateTime @default(now())
  
  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recordedBy   User?    @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  
  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
  @@index([recordedById])
  @@map("attendance")
}

model MemberEngagement {
  userId             String   @id
  engagementScore    Float    @default(0)    // 0-100 engagement score
  lastCalculated     DateTime @default(now())
  
  // Engagement components (PHASE3_SPECS.md 1.5), each 0-100. engagementScore weighs them
  // 0.6 / 0.2 / 0.2. Giving and volunteer scores were removed in P3-D3 (no data source).
  attendanceScore    Float    @default(0)    // Attended / scoring services, last 12 weeks
  communityScore     Float    @default(0)    // Active group memberships: 0, 60 or 100
  communicationScore Float    @default(0)    // Response rate on two-way interactions, 12 months

  // Activity counters (rolling 12 months)
  servicesAttended   Int      @default(0)
  eventsAttended     Int      @default(0)

  // Lifecycle indicators
  membershipStage    MembershipStage @default(visitor)
  riskLevel          RiskLevel       @default(low)
  lastActivity       DateTime?
  
  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([engagementScore])
  @@index([membershipStage])
  @@index([riskLevel])
  @@map("member_engagement")
}

// The engagement row as it stood in a month (PHASE3_SPECS.md 1.5): every refresh upserts the row
// of the current month, so the last refresh of a month is what that month keeps.
model EngagementSnapshot {
  id                 String          @id @default(cuid())
  userId             String
  month              DateTime        @db.Date // First day of the month (UTC)
  engagementScore    Float
  attendanceScore    Float
  communityScore     Float
  communicationScore Float
  membershipStage    MembershipStage
  riskLevel          RiskLevel
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("engagement_snapshots")
}

model MemberActivity {
  id          String   @id @default(cuid())
  userId      String
  activityType ActivityType
  description String?
  metadata    Json?    // Additional data (an object)
  points      Int      @default(0) // Points awarded for this activity
  
  // Timestamps
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("member_activities")
}

model MemberInteraction {
  id             String   @id @default(cuid())
  userId         String
  interactionType InteractionType
  subject        String?
  content        String?
  staffMemberId  String?  // Who initiated the interaction
  staffMember    User?    @relation("InteractionStaff", fields: [staffMemberId], references: [id], onDelete: SetNull)
  channel        Channel
  status         InteractionStatus @default(completed)
  
  // Phase 3: Enhanced interaction tracking
  category       InteractionCategory?
  priority       Priority @default(normal)
  responseRequired Boolean @default(false)
  responseReceived Boolean @default(false)
  
  // Metadata
  metadata       Json?    // Additional data (an object)
  responseTime   Int?     // Minutes to respond (for two-way communications)
  
  // Timestamps
  scheduledFor   DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  
  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([staffMemberId])
  @@map("member_interactions")
}

model MemberMilestone {
  id            String   @id @default(cuid())
  userId        String
  milestoneType MilestoneType
  title         String
  description   String?
  achievedDate  DateTime
  isPublic      Boolean  @default(true)
  celebrated    Boolean  @default(false)
  
  // Phase 3: Enhanced milestone categorization
  category      MilestoneCategory @default(general)
  impact        Impact   @default(medium)
  autoGenerated Boolean  @default(false)     // Whether milestone was auto-detected
  
  // Timestamps
  createdAt     DateTime @default(now())
  
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, achievedDate])
  @@map("member_milestones")
}

model MemberNote {
  id           String   @id @default(cuid())
  userId       String
  authorId     String   // Staff member who wrote the note
  author       User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title        String?
  content      String
  noteType     NoteType @default(general)
  isPrivate    Boolean  @default(false)
  isFollowUp   Boolean  @default(false)
  followUpDate DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([authorId])
  @@map("member_notes")
}

model MemberTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3B82F6") // Hex color for UI display
  category  TagCategory @default(general)
  isActive  Boolean  @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  
  // Relations
  memberTags UserTag[]
  
  @@map("member_tags")
}

model UserTag {
  id       String @id @default(cuid())
  userId   String
  tagId    String
  addedById String? // Staff member who added the tag
  addedBy   User?   @relation("TagAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt  DateTime @default(now())
  
  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag      MemberTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([userId, tagId])
  @@index([tagId])
  @@index([addedById])
  @@map("user_tags")
}

model SavedSearch {
  id          String   @id @default(cuid())
  name        String
  description String?
  query       Json     // A searchQuery (validated on save and on load)
  isPublic    Boolean  @default(false)
  createdById String   // User who created the search
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  usageCount  Int      @default(0)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsed    DateTime?
  
  @@index([createdById])
  @@map("saved_searches")
}

// Enums (PHASE3_SPECS.md 1.1). The value lists mirror packages/shared/src/enums.ts in the same
// order; backend/test/enums.test.ts keeps them equal.

enum MembershipStage {
  visitor
  new_member
  active_member
  core_member
  leader
  at_risk
  inactive
}

enum RiskLevel {
  low
  medium
  high
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  separated
}

enum MembershipType {
  member
  visitor
  regular_attendee
  inactive
}

enum MediaType {
  YOUTUBE_VIDEO
}

enum RelationshipType {
  spouse
  parent
  child
  sibling
  grandparent
  grandchild
  other
}

enum GroupType {
  ministry
  small_group
  committee
  service_team
}

enum GroupMemberRole {
  leader
  co_leader
  member
}

enum ServiceType {
  sunday_service
  bible_study
  prayer_meeting
  special_event
  other
}

enum InteractionType {
  email_sent
  email_opened
  sms_sent
  sms_replied
  call_made
  visit_logged
  note_added
}

enum Channel {
  email
  sms
  phone
  in_person
  social_media
}

enum InteractionStatus {
  scheduled
  completed
  failed
}

enum InteractionCategory {
  welcome
  follow_up
  pastoral_care
  event_invitation
  giving_reminder
  volunteer_request
}

enum Priority {
  low
  normal
  high
  urgent
}

enum MilestoneType {
  first_visit
  baptism
  confirmation
  wedding
  first_volunteer
  leadership_role
  anniversary
  other
}

enum MilestoneCategory {
  spiritual
  service
  family
  personal
  ministry
  general
}

enum Impact {
  low
  medium
  high
}

enum NoteType {
  general
  pastoral_care
  follow_up
  prayer_request
  concern
}

enum TagCategory {
  ministry
  demographic
  interest
  status
  general
}

enum ActivityType {
  service_attendance
  event_attendance
  donation
  volunteer
  ministry_participation
  communication_open
  profile_update
  other
}
