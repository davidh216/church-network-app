# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
# SQLite for now (Phase 1 moves to Postgres): path is relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Optional: first admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
