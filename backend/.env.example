# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
# PostgreSQL 16 (docker compose at the repo root, or a local server with these credentials)
DATABASE_URL="postgresql://church:church@localhost:5432/church_dev?schema=public"
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Attempts allowed per window: login per IP and email (and five times that per IP),
# registration per IP. The defaults are shown.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# Express trust proxy setting: which upstream addresses may set X-Forwarded-For; the Next.js
# rewrite and any reverse proxy in front of it must be covered. A comma-separated list of
# addresses, subnets or the names loopback, linklocal, uniquelocal; a number of hops; or false.
# Next.js adds no X-Forwarded-For itself and forwards a client-sent one unchanged, so the reverse
# proxy in front of Next must set (or append to) the header and Next must not be reachable
# directly. Without such a proxy use false: all clients then share one rate-limit address, but
# nobody can forge theirs.
# TRUST_PROXY=loopback, uniquelocal
# Session cookie Secure flag: true or false; unset means on when NODE_ENV=production. Only for a
# production build served over plain HTTP (the local compose stack); leave unset in real
# deployments behind TLS.
# COOKIE_SECURE=
# Optional: first admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
