# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
# PostgreSQL 16 (docker compose at the repo root, or a local server with these credentials)
DATABASE_URL="postgresql://church:church@localhost:5432/church_dev?schema=public"
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Optional: first admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
